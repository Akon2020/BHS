# Modèle de configuration. Copier en :
#   - .env.development.local  (npm run dev)
#   - .env.production.local   (npm start → NODE_ENV=production)
# Ne jamais commiter les fichiers réels.

NODE_ENV="production"
PORT=5500

# Base MySQL
DB_HOST=localhost
DB_USER=
DB_PASS=
DB_NAME=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN="1d"

# SMTP
EMAIL_HOST=
EMAIL=
EMAIL_PASSWORD=
CONTACT_EMAIL=

# URLs publiques
URL_ORIGIN="*"
HOST_URL="https://api.burningheartihs.org"
FRONT_URL="https://burningheartihs.org"

# Domaine du cookie d'authentification, partagé entre le front et l'API.
# Indispensable en production : sans lui, le front (proxy.ts) ne voit pas
# le cookie et renvoie vers /connexion après chaque connexion.
# Laisser vide en développement (localhost).
COOKIE_DOMAIN=".burningheartihs.org"

DEFAULT_PASSWD=
