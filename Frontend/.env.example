# Modèle de configuration. Next.js charge :
#   - .env.production  pour `npm run build` / `npm start`
#   - .env             (et .env.development) pour `npm run dev`
# NEXT_PUBLIC_API_URL est figée dans le bundle AU MOMENT DU BUILD :
# toute modification impose un nouveau `npm run build`.

NEXT_PUBLIC_API_URL="https://api.burningheartihs.org"
