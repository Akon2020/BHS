# URL de l'API backend (préfixe EXPO_PUBLIC_ = exposé au bundle mobile).
# Fallback dans le code : https://api.burningheartihs.org
EXPO_PUBLIC_API_URL=https://api.burningheartihs.org

# Notifications push : mock tant que le module backend n'existe pas (project.md §5.1).
EXPO_PUBLIC_USE_MOCK_NOTIFICATIONS=true

# Sentry (optionnel) : sans DSN, la télémétrie est désactivée (no-op).
EXPO_PUBLIC_SENTRY_DSN=
