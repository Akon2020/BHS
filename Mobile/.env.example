# URL de l'API backend (préfixe EXPO_PUBLIC_ = exposé au bundle mobile).
# Fallback dans le code si absent : https://api.burningheartihs.org
# En dev local sur appareil physique, utilisez l'IP LAN de votre machine dans .env.local,
# ex. EXPO_PUBLIC_API_URL=http://192.168.1.10:5500
EXPO_PUBLIC_API_URL=https://api.burningheartihs.org

# Notifications : réelles par défaut. Passez à "true" uniquement pour le dev hors-ligne (mock).
EXPO_PUBLIC_USE_MOCK_NOTIFICATIONS=false

# Sentry (optionnel) : sans DSN, la télémétrie est désactivée (no-op).
# Renseignez votre DSN réel dans .env.local (non commité), pas dans ce template.
EXPO_PUBLIC_SENTRY_DSN=
